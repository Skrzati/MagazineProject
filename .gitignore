# ==========================================
# Środowiska programistyczne (IDE)
# ==========================================

# IntelliJ IDEA (Spring Boot)
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code (React)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# ==========================================
# Backend: Java / Spring Boot
# ==========================================

# Skompilowane klasy
*.class

# Pliki logów
*.log

# Pliki pakietów
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Logi błędów maszyny wirtualnej Java
hs_err_pid*
replay_pid*

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
# (Zazwyczaj plik jar wrappera zostawiamy w repozytorium)
# .mvn/wrapper/maven-wrapper.jar

# Gradle
.gradle/
build/
# (Ignoruj pliki wewnątrz katalogu build, z wyjątkiem samego build)
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# ==========================================
# Frontend: React / Node.js
# ==========================================

# Zależności
node_modules/
jspm_packages/

# Logi
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Wyniki budowania aplikacji (build/dist)
dist/
build/
out/

# Pliki środowiskowe (KRYTYCZNE - nie dodawaj do repo!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Pamięć podręczna (cache)
.npm
.eslintcache
.stylelintcache
.parcel-cache

# ==========================================
# Pliki systemowe (Windows / macOS / Linux)
# ==========================================

